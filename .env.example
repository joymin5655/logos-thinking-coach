# 실제 키는 gitignored `.env.local`에 둔다 (~/Dev_key/logos_key/anthropic.env 로의 심볼릭 링크).
# 키는 서버(Vercel Function / vite dev 미들웨어)에서만 읽는다. VITE_ 접두사를 붙이지 말 것.
ANTHROPIC_API_KEY=
# Supabase 프로젝트 URL과 publishable 키(구 anon 키 포함). 공개 값이라 브라우저 번들에 들어가고,
# 서버도 같은 이름으로 읽어 로그인 토큰 검증·한도 확인(consume_quota RPC)에 쓴다. 접근 제어는 RLS가 맡는다.
# secret / service_role 키는 어디에도 두지 않는다.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# 추가로 허용할 Origin(쉼표 구분, 예: https://logos.example.com). 스킴이 없으면 https로 본다.
# Vercel 배포 URL(production·preview)은 VERCEL_* 환경 변수로 자동 허용되고,
# localhost는 로컬 개발(VERCEL_ENV 없음)에서만 허용된다.
ALLOWED_ORIGINS=
